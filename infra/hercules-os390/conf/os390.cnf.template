#**********************************************************************
#  OS/390 (ADCD) on SDL Hyperion 4.9.1: Hercules configuration template
#
#  prepare-os390.sh copies this to os390/conf/os390.cnf. Lines marked
#  @ADCD@ depend on the ADCD release: take them from the ADCD's own
#  documentation (its readme or "system guide" lists the volumes, their
#  device addresses, the IPL address and LOADPARM, and the terminal and
#  console addresses its IODF defines). Don't guess them: a wrong device
#  address or LOADPARM just gives a wait state.
#**********************************************************************

MODPATH     hercules/lib/hercules   # Hercules' device modules (LCS, 3270, ...)

# ── Processor ────────────────────────────────────────────────────────
ARCHLVL     ESA/390                 # OS/390 2.x runs in ESA/390 mode
CPUMODEL    7060                    # Multiprise 3000, like the museum's own
CPUSERIAL   000390
LPARNAME    OS390
NUMCPU      2
MAINSIZE    512                     # MB; @ADCD@ check the minimum it asks for
TZOFFSET    +0000
OSTAILOR    OS/390
DIAG8CMD    DISABLE                 # the guest can't issue Hercules commands
# Some ADCD releases check the date; if this one refuses to start, Hercules
# can run the clock back (YROFFSET/SYSEPOCH). Licence terms still apply.

# ── Consoles and the HTTP console ────────────────────────────────────
CNSLPORT    3270                    # Hercules' TN3270 port (plain TN3270)
HTTP        PORT 8038               # no auth: compose binds it to the tailnet only
HTTP        ROOT hercules/httproot
HTTP        START

# ── IPL ──────────────────────────────────────────────────────────────
# @ADCD@ the IPL volume's address and the LOADPARM (IODF suffix + nucleus):
# IPL       0A80
# LOADPARM  0A82xxM1

# ── 3270 terminals and the MVS master console ────────────────────────
# @ADCD@ the addresses the IODF defines for local non-SNA 3270s. Typically
# one is the master console (group CONS, so a client can ask for it by LU)
# and the rest are VTAM terminals for TSO.
# 0700      3270  CONS
# 0701-070F 3270

# ── DASD (the licensed ADCD volumes, in os390/dasd) ──────────────────
# @ADCD@ one line per volume: address, device type, file. Compressed
# (CCKD) images work as they are; Hercules creates shadow files if asked.
# 0A80      3390  dasd/<IPL volume, e.g. OS39RA>.cckd
# 0A81      3390  dasd/<next volume>.cckd

# ── OS/390's own TCP/IP (and its TN3270E server) ─────────────────────
# @ADCD@ the adapter its TCPIP PROFILE uses: an LCS (OSA) pair or a CTC pair.
# The guest's address goes in compose (.env OS390_IP); the entrypoint NATs
# the container's port 2323 to its TN3270E server. Check the statement's
# options against Hercules' LCS/CTCI documentation for 4.9 before use.
# LCS:   0E20.2 LCS -n /dev/net/tun -a 10.1.1.1 10.1.1.2
# CTCI:  0E40.2 CTCI -n /dev/net/tun 10.1.1.2 10.1.1.1

# ── Printers, readers ────────────────────────────────────────────────
# @ADCD@ if its JES2 needs them; output to os390/prt.
# 000E      1403  prt/prt00e.txt crlf
